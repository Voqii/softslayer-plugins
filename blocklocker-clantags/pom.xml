<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>net.voqii</groupId>
  <artifactId>blocklocker-clantags</artifactId>
  <version>1.0.0</version>
  <packaging>jar</packaging>
  <name>BlockLockerClanTags</name>
  <description>Adds SimpleClans clan-tag matching to BlockLocker protection signs.</description>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>21</maven.compiler.release>
  </properties>

  <repositories>
    <repository>
      <id>papermc</id>
      <url>https://repo.papermc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>codemc</id>
      <url>https://repo.codemc.io/repository/maven-public/</url>
    </repository>
    <repository>
      <id>jitpack</id>
      <url>https://jitpack.io</url>
    </repository>
  </repositories>

  <dependencies>
    <!-- Server API. Any Bukkit/Spigot/Paper API of the target MC version works;
         only org.bukkit.entity.Player and JavaPlugin are used. -->
    <dependency>
      <groupId>io.papermc.paper</groupId>
      <artifactId>paper-api</artifactId>
      <version>1.21.4-R0.1-SNAPSHOT</version>
      <scope>provided</scope>
    </dependency>

    <!-- BlockLocker: provides the GroupSystem API we plug into. -->
    <dependency>
      <groupId>com.github.rutgerkok</groupId>
      <artifactId>BlockLocker</artifactId>
      <version>v1.14.1</version>
      <scope>provided</scope>
    </dependency>

    <!-- SimpleClans: provides Clan / ClanPlayer / getTag(). -->
    <dependency>
      <groupId>com.github.SimpleClans</groupId>
      <artifactId>SimpleClans</artifactId>
      <version>2.19.2</version>
      <scope>provided</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>BlockLockerClanTags-${project.version}</finalName>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
        <filtering>true</filtering>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
      </plugin>
    </plugins>
  </build>
</project>

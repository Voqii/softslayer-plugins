# Bot token from the Discord Developer Portal -> SS-Bot -> Bot -> Reset Token
DISCORD_TOKEN=
# Must match "secret" in plugins/SimpleClans/bridge-config.yml
BRIDGE_SECRET=
BRIDGE_URL=http://127.0.0.1:8787
POLL_MS=1500
# poll = bot polls BRIDGE_URL (bot on the same host as the MC server)
# listen = MC server POSTs to us (plugin bridge-config.yml mode: remote), e.g. BloomHost/Pterodactyl
BRIDGE_MODE=poll
LISTEN_HOST=127.0.0.1
LISTEN_PORT=8790

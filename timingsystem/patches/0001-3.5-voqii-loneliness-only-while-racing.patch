+import me.makkuusen.timing.system.timetrial.TimeTrialController;
 import org.bukkit.Bukkit;
 import org.bukkit.entity.*;
 import org.bukkit.event.EventHandler;
@@ -55,8 +56,9 @@ public class LonelinessController implements Listener {
                     // Show all drivers, activate nocol
                     showAllOthers(player);
                     setCollisionMode(player, false);
-                } else if (!TimingSystem.configuration.isLonelinessEnabled()) {
-                    // Loneliness disabled by config outside of loneliness heats
+                } else if (!TimingSystem.configuration.isLonelinessEnabled() || !isInTimeTrial(player)) {
+                    // Loneliness disabled by config outside of loneliness heats, and (SoftSlayer fork)
+                    // a boat outside a time trial isn't racing, so nobody is hidden
                     showAllOthers(player);
                 } else {
                     // Hide all players
@@ -221,6 +223,23 @@ public class LonelinessController implements Listener {
                 .toList();
     }
 
+    private static boolean isInTimeTrial(Player player) {
+        return TimeTrialController.timeTrials.containsKey(player.getUniqueId());
+    }
+
+    /**
+     * SoftSlayer fork: called whenever a player's time trial ends, however it ends (finish, cancel, leaving the
+     * boat, death, quit...), so the players hidden during the run show up again.
+     */
+    public static void onTimeTrialEnded(UUID uuid) {
+        Bukkit.getScheduler().runTask(plugin, () -> {
+            Player player = Bukkit.getPlayer(uuid);
+            if (player != null) {
+                updatePlayersVisibility(player);
+            }
+        });
+    }
+
     private static boolean isPlayerInBoat(Player player) {
         Entity vehicle = player.getVehicle();
         return vehicle instanceof Boat || vehicle instanceof ChestBoat;
@@ -240,8 +259,10 @@ public class LonelinessController implements Listener {
         boolean viewingIsDriver = viewingMaybeDriver.isPresent();
         Heat viewingHeat = viewingIsDriver ? viewingMaybeDriver.get().getHeat() : viewingStreakingHeat;
 
-        // When loneliness is disabled by config, it only applies in loneliness heats (collision mode DISABLED)
-        boolean lonelinessApplies = TimingSystem.configuration.isLonelinessEnabled()
+        // When loneliness is disabled by config, it only applies in loneliness heats (collision mode DISABLED).
+        // SoftSlayer fork: when enabled, it only applies while racing (a heat or a time trial), not in any boat anywhere.
+        boolean lonelinessApplies = (TimingSystem.configuration.isLonelinessEnabled()
+                        && (viewingHeat != null || isInTimeTrial(viewingPlayer)))
                 || (viewingHeat != null && viewingHeat.getCollisionMode() == CollisionMode.DISABLED);
 
         if ((canUseNocol && lonelinessDisabled) || !lonelinessApplies) {
diff --git a/src/main/java/me/makkuusen/timing/system/timetrial/TimeTrialController.java b/src/main/java/me/makkuusen/timing/system/timetrial/TimeTrialController.java

diff --git a/src/main/java/com/planetgallium/kitpvp/game/CombatLog.java b/src/main/java/com/planetgallium/kitpvp/game/CombatLog.java
new file mode 100644
index 0000000..06f3661
--- /dev/null
+++ b/src/main/java/com/planetgallium/kitpvp/game/CombatLog.java
@@ -0,0 +1,244 @@
+package com.planetgallium.kitpvp.game;
+
+import com.planetgallium.kitpvp.Game;
+import com.planetgallium.kitpvp.util.Resource;
+import com.planetgallium.kitpvp.util.Toolkit;
+import net.md_5.bungee.api.ChatMessageType;
+import net.md_5.bungee.api.chat.TextComponent;
+import org.bukkit.Bukkit;
+import org.bukkit.entity.Player;
+import org.bukkit.event.EventHandler;
+import org.bukkit.event.EventPriority;
+import org.bukkit.event.Listener;
+import org.bukkit.event.entity.PlayerDeathEvent;
+import org.bukkit.event.player.PlayerCommandPreprocessEvent;
+import org.bukkit.event.player.PlayerKickEvent;
+import org.bukkit.event.player.PlayerQuitEvent;
+import org.bukkit.scheduler.BukkitRunnable;
+
+import java.lang.reflect.Method;
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Iterator;
+import java.util.List;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+
+/**
+ * Combat logging, handled by KitPvP itself so no separate combat-log plugin is needed in the arena.
+ * <p>
+ * A hit between two players in the arena puts both "in combat" for Combat.Logout.Seconds. While in
+ * combat, the commands in Combat.Logout.BlockedCommands (/spawn, /home, ...) are refused, and leaving
+ * the server kills the player on the spot: their items drop as usual for a death, the last player who
+ * hit them gets the kill (stats, XP, Kill.Commands, kill streak) and the death is announced with
+ * Death.Messages.CombatLog. Kicks (unless Combat.Logout.PunishKicks), a server shutdown and players
+ * with kp.combatlog.bypass are left alone.
+ */
+public class CombatLog implements Listener {
+
+	private final Game plugin;
+	private final Arena arena;
+	private final Resource config;
+
+	/** Player name -> when their combat tag runs out (epoch millis). */
+	private final Map<String, Long> taggedUntil = new HashMap<>();
+	private final Set<String> kicked = new HashSet<>();
+	/** Players being killed for logging out right now (read by the death message). */
+	private final Set<String> loggingOut = new HashSet<>();
+
+	public CombatLog(Game plugin, Arena arena) {
+		this.plugin = plugin;
+		this.arena = arena;
+		this.config = plugin.getResources().getConfig();
+
+		new BukkitRunnable() {
+			@Override
+			public void run() {
+				tick();
+			}
+		}.runTaskTimer(plugin, 20L, 20L);
+	}
+
+	private boolean enabled() {
+		return !config.contains("Combat.Logout.Enabled") || config.getBoolean("Combat.Logout.Enabled");
+	}
+
+	private int seconds() {
+		return config.contains("Combat.Logout.Seconds") ? Math.max(1, config.getInt("Combat.Logout.Seconds")) : 15;
+	}
+
+	/** Called for every landed hit between two players in the arena. */
+	public void tag(Player victim, Player attacker) {
+		if (!enabled()) {
+			return;
+		}
+		tagOne(victim);
+		tagOne(attacker);
+	}
+
+	private void tagOne(Player p) {
+		if (p.hasPermission("kp.combatlog.bypass")) {
+			return;
+		}
+		boolean wasTagged = isTagged(p.getName());
+		taggedUntil.put(p.getName(), System.currentTimeMillis() + seconds() * 1000L);
+		if (!wasTagged) {
+			send(p, "Combat.Logout.TagMessage");
+		}
+	}
+
+	public boolean isTagged(String name) {
+		Long until = taggedUntil.get(name);
+		return until != null && until > System.currentTimeMillis();
+	}
+
+	private int secondsLeft(String name) {
+		Long until = taggedUntil.get(name);
+		return until == null ? 0 : (int) Math.max(0, Math.ceil((until - System.currentTimeMillis()) / 1000.0));
+	}
+
+	public boolean isLoggingOut(String name) {
+		return loggingOut.contains(name);
+	}
+
+	/** Every second: the action bar countdown, and the "no longer in combat" message when it ends. */
+	private void tick() {
+		boolean actionBar = !config.contains("Combat.Logout.ActionBar") || config.getBoolean("Combat.Logout.ActionBar");
+		Iterator<Map.Entry<String, Long>> it = taggedUntil.entrySet().iterator();
+		while (it.hasNext()) {
+			Map.Entry<String, Long> e = it.next();
+			Player p = Bukkit.getPlayerExact(e.getKey());
+			if (p == null) {
+				it.remove();
+				continue;
+			}
+			if (e.getValue() <= System.currentTimeMillis()) {
+				it.remove();
+				send(p, "Combat.Logout.UntagMessage");
+				if (actionBar) {
+					p.spigot().sendMessage(ChatMessageType.ACTION_BAR, new TextComponent(""));
+				}
+			} else if (actionBar && config.contains("Combat.Logout.ActionBarText")) {
+				String text = config.fetchString("Combat.Logout.ActionBarText")
+						.replace("%seconds%", String.valueOf(secondsLeft(e.getKey())));
+				p.spigot().sendMessage(ChatMessageType.ACTION_BAR, TextComponent.fromLegacyText(Toolkit.translate(text)));
+			}
+		}
+	}
+
+	@EventHandler(priority = EventPriority.LOW, ignoreCancelled = true)
+	public void onCommand(PlayerCommandPreprocessEvent e) {
+		Player p = e.getPlayer();
+		if (!enabled() || !isTagged(p.getName()) || p.hasPermission("kp.combatlog.bypass")) {
+			return;
+		}
+		String line = e.getMessage().substring(1).toLowerCase(Locale.ROOT).trim();
+		int space = line.indexOf(' ');
+		String label = space < 0 ? line : line.substring(0, space);
+		String rest = space < 0 ? "" : line.substring(space);
+		int colon = label.indexOf(':'); // essentials:spawn -> spawn
+		if (colon >= 0) {
+			label = label.substring(colon + 1);
+		}
+		String command = label + rest;
+
+		List<String> blocked = config.getStringList("Combat.Logout.BlockedCommands");
+		for (String b : blocked) {
+			String entry = b.toLowerCase(Locale.ROOT).trim();
+			if (entry.startsWith("/")) {
+				entry = entry.substring(1);
+			}
+			if (!entry.isEmpty() && (command.equals(entry) || command.startsWith(entry + " "))) {
+				e.setCancelled(true);
+				String msg = config.fetchString("Combat.Logout.BlockedMessage");
+				if (msg != null && !msg.isEmpty()) {
+					p.sendMessage(Toolkit.translate(msg.replace("%seconds%", String.valueOf(secondsLeft(p.getName())))));
+				}
+				return;
+			}
+		}
+	}
+
+	@EventHandler(priority = EventPriority.MONITOR, ignoreCancelled = true)
+	public void onKick(PlayerKickEvent e) {
+		if (!config.getBoolean("Combat.Logout.PunishKicks")) {
+			kicked.add(e.getPlayer().getName());
+		}
+	}
+
+	// LOWEST: before LeaveListener and KillStreaks forget the player's hits and streak
+	@EventHandler(priority = EventPriority.LOWEST)
+	public void onQuit(PlayerQuitEvent e) {
+		Player p = e.getPlayer();
+		String name = p.getName();
+		boolean wasKicked = kicked.remove(name);
+		boolean tagged = isTagged(name);
+		taggedUntil.remove(name);
+
+		if (!enabled() || !tagged || wasKicked || serverStopping() || !Toolkit.inArena(p)
+				|| p.hasPermission("kp.combatlog.bypass") || p.isDead() || p.getHealth() <= 0) {
+			return;
+		}
+
+		Player killer = Toolkit.getPlayer(p.getWorld(), arena.getRecentAttacker(name));
+		if (killer != null) {
+			setKiller(p, killer); // so kill streaks count it too
+		}
+		loggingOut.add(name);
+		try {
+			p.setHealth(0); // a normal death: drops, kill credit, stats, streaks, Death.Commands
+		} finally {
+			loggingOut.remove(name);
+		}
+
+		List<String> commands = config.getStringList("Combat.Logout.Commands");
+		if (!commands.isEmpty()) {
+			Toolkit.runCommands(p, commands, "%player%", name);
+		}
+		plugin.getLogger().info(name + " logged out in combat" + (killer != null ? " (kill to " + killer.getName() + ")" : ""));
+	}
+
+	@EventHandler(priority = EventPriority.MONITOR)
+	public void onDeath(PlayerDeathEvent e) {
+		taggedUntil.remove(e.getEntity().getName());
+	}
+
+	private void send(Player p, String path) {
+		if (config.contains(path)) {
+			String msg = config.fetchString(path).replace("%seconds%", String.valueOf(seconds()));
+			if (!msg.isEmpty()) {
+				p.sendMessage(Toolkit.translate(msg));
+			}
+		}
+	}
+
+	/** Paper's Bukkit.isStopping() (not in the Spigot API this builds against): players leaving in a shutdown aren't logging out. */
+	private static boolean serverStopping() {
+		try {
+			return (Boolean) Bukkit.class.getMethod("isStopping").invoke(null);
+		} catch (ReflectiveOperationException | ClassCastException ex) {
+			return false;
+		}
+	}
+
+	private static Method setKiller;
+	private static boolean setKillerLooked;
+
+	/** Paper's LivingEntity#setKiller (not in the Spigot API this builds against). */
+	private static void setKiller(Player victim, Player killer) {
+		if (!setKillerLooked) {
+			setKillerLooked = true;
+			try {
+				setKiller = victim.getClass().getMethod("setKiller", Player.class);
+			} catch (NoSuchMethodException ignored) {
+			}
+		}
+		if (setKiller != null) {
+			try {
+				setKiller.invoke(victim, killer);
+			} catch (ReflectiveOperationException ignored) {
+			}
+		}
+	}
+}

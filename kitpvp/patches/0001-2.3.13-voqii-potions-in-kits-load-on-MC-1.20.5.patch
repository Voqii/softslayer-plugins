-                resource.set(effectPath + "." + effectName + ".Upgraded", data.isUpgraded());
-                resource.set(effectPath + "." + effectName + ".Extended", data.isExtended());
-                resource.save();
+                serializeBasePotion(resource, meta, effectPath);
             }
         }
     }
 
+    // voqii: the effect name loses the potion (Turtle Master saved as SLOWNESS) and water/awkward bottles have no
+    // effect at all (NPE). On 1.20.2+ save the base potion type's own name instead; AttributeParser reads it back.
+    private static void serializeBasePotion(Resource resource, PotionMeta meta, String effectPath) {
+        try {
+            PotionType type = meta.getBasePotionType();
+            if (type == null) return;
+            String name = type.name();
+            String baseName = name.replaceFirst("^(STRONG|LONG)_", "");
+            resource.set(effectPath + "." + baseName + ".Upgraded", name.startsWith("STRONG_"));
+            resource.set(effectPath + "." + baseName + ".Extended", name.startsWith("LONG_"));
+            resource.save();
+        } catch (NoSuchMethodError legacyApi) {
+            PotionData data = meta.getBasePotionData();
+
+            String effectName = data.getType().getEffectType().getName();
+            resource.set(effectPath + "." + effectName + ".Upgraded", data.isUpgraded());
+            resource.set(effectPath + "." + effectName + ".Extended", data.isExtended());
+            resource.save();
+        }
+    }
+

@@ -213,10 +213,13 @@ public class AttributeParser {
         String firstChildEffectName = resource.getConfigurationSection(path).getKeys(false).toArray()[0].toString();
         String firstChildPath = path + "." + firstChildEffectName;
 
-        PotionType potionType = XPotion.matchXPotion(firstChildEffectName).get().getPotionType();
         boolean isUpgraded = resource.getBoolean(firstChildPath + ".Upgraded");
         boolean isExtended = resource.getBoolean(firstChildPath + ".Extended");
 
+        // voqii: kits saved by this fork store the potion type's name (TURTLE_MASTER, WATER), older kits the effect name
+        PotionType namedType = Toolkit.versionToNumber() >= 19 ? potionTypeByName(firstChildEffectName) : null;
+        PotionType potionType = namedType != null ? namedType : XPotion.matchXPotion(firstChildEffectName).get().getPotionType();
+
         if (Toolkit.versionToNumber() == 18) {
             boolean isSplash = resource.fetchString(path.replace("Effects", "") + ".Type").equals("SPLASH_POTION");
             Potion potion = Potion.fromItemStack(item);
@@ -227,7 +230,7 @@ public class AttributeParser {
 
             return potion.toItemStack(item.getAmount());
         } else if (Toolkit.versionToNumber() >= 19) {
-            potionMeta.setBasePotionData(new PotionData(potionType, isExtended, isUpgraded));
+            setBasePotion(potionMeta, potionType, isExtended, isUpgraded);
         }
 
         item.setItemMeta(potionMeta);
@@ -235,6 +238,32 @@ public class AttributeParser {
         return item;
     }
 
+    // voqii: on 1.20.5+ the matched PotionType can already be a STRONG_/LONG_ variant (or a potion with no
+    // level II), and new PotionData(type, extended, upgraded=true) then throws "Potion Type is not upgradable",
+    // which killed /kp kit and /kp preview for any kit holding a level II potion. Pick the variant by name.
+    private static void setBasePotion(PotionMeta potionMeta, PotionType potionType, boolean isExtended, boolean isUpgraded) {
+        try {
+            String baseName = potionType.name().replaceFirst("^(STRONG|LONG)_", "");
+            PotionType resolved = null;
+            if (isUpgraded) resolved = potionTypeByName("STRONG_" + baseName);
+            if (resolved == null && isExtended) resolved = potionTypeByName("LONG_" + baseName);
+            if (resolved == null) resolved = potionTypeByName(baseName);
+            potionMeta.setBasePotionType(resolved != null ? resolved : potionType);
+        } catch (NoSuchMethodError legacyApi) {
+            // before 1.20.2 there is no setBasePotionType; PotionData only rejects flags the type can't take
+            potionMeta.setBasePotionData(new PotionData(potionType,
+                    isExtended && potionType.isExtendable(), isUpgraded && potionType.isUpgradeable()));
+        }
+    }
+
+    private static PotionType potionTypeByName(String name) {
+        try {
+            return PotionType.valueOf(name);
+        } catch (IllegalArgumentException e) {
+            return null;
+        }
+    }
+
     private static void setCustomEffectsFromPath(ItemStack item, Resource resource, String path) {
         PotionMeta potionMeta = (PotionMeta) item.getItemMeta();
 

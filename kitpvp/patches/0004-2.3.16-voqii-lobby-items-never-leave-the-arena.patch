 		CacheManager.getPotionSwitcherUsers().remove(p.getName());
@@ -152,6 +149,48 @@ public class Arena {
 		stats.pushCachedStatsToDatabase(p.getName(), true);
 	}
 	
+	/**
+	 * Clears the inventory of a player leaving the arena (Arena.ClearInventoryOnLeave). Everyone else, including
+	 * players who keep their inventory (kp.inventory.keep), still loses the lobby items (kit selector, leave
+	 * clock...), so those never leave the arena.
+	 */
+	public void clearInventoryOnLeave(Player p) {
+		if (config.getBoolean("Arena.ClearInventoryOnLeave") && !Toolkit.keepsInventory(p)) {
+			p.getInventory().clear();
+			p.getInventory().setArmorContents(null);
+			return;
+		}
+
+		removeArenaItems(p);
+	}
+
+	/** Removes the items {@link #giveArenaItems} hands out, matched the way ItemListener matches clicks on them. */
+	public void removeArenaItems(Player p) {
+		ItemStack[] contents = p.getInventory().getContents();
+		for (int slot = 0; slot < contents.length; slot++) {
+			if (isArenaItem(contents[slot])) {
+				p.getInventory().setItem(slot, null);
+			}
+		}
+		if (isArenaItem(p.getItemOnCursor())) {
+			p.setItemOnCursor(null);
+		}
+	}
+
+	private boolean isArenaItem(ItemStack item) {
+		ConfigurationSection items = config.getConfigurationSection("Items");
+		if (item == null || items == null) return false;
+
+		for (String identifier : items.getKeys(false)) {
+			String itemPath = "Items." + identifier;
+			if (Toolkit.hasMatchingMaterial(item, config.fetchString(itemPath + ".Material")) &&
+					Toolkit.hasMatchingDisplayName(item, config.fetchString(itemPath + ".Name"))) {
+				return true;
+			}
+		}
+		return false;
+	}
+
 	public void giveArenaItems(Player p) {
 		ConfigurationSection items = config.getConfigurationSection("Items");
 

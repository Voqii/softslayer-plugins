+    private void executeAddDropCommand(Player p) {
+        String arenaName = p.getWorld().getName();
+        int dropNumber = Toolkit.getNextAvailable(config, "Drops." + arenaName,
+                1000, false, 1);
+
+        Toolkit.saveLocationToResource(config, "Drops." + arenaName + "." + dropNumber, p.getLocation());
+
+        p.sendMessage(messages.fetchString("Messages.Commands.AddedDrop")
+                .replace("%number%", String.valueOf(dropNumber))
+                .replace("%arena%", arenaName));
+        Toolkit.playSoundToPlayer(p, "ENTITY_ZOMBIE_ATTACK_WOODEN_DOOR", 1);
+    }
+
+    private void executeDeleteDropsCommand(Player p) {
+        String arenaName = p.getWorld().getName();
+
+        if (config.contains("Drops." + arenaName)) {
+            config.set("Drops." + arenaName, null);
+            config.save();
+
+            p.sendMessage(messages.fetchString("Messages.Commands.RemovedDrops").replace("%arena%", arenaName));
+            Toolkit.playSoundToPlayer(p, "ENTITY_ZOMBIE_ATTACK_WOODEN_DOOR", 1);
+        } else {
+            p.sendMessage(messages.fetchString("Messages.Error.Arena").replace("%arena%", arenaName));
+        }
+    }
+
     private void executeDeleteArenaCommand(Player p) {
         String arenaName = p.getWorld().getName();
 
diff --git a/src/main/java/com/planetgallium/kitpvp/game/Arena.java b/src/main/java/com/planetgallium/kitpvp/game/Arena.java
index b2e729b..ec0e730 100644
--- a/src/main/java/com/planetgallium/kitpvp/game/Arena.java
+++ b/src/main/java/com/planetgallium/kitpvp/game/Arena.java
@@ -180,6 +180,21 @@ public class Arena {
 		}
 	}
 	
+	/** voqii: sends a player who just picked a kit to a random drop point of their world, if it has any. */
+	public void toKitDrop(Player p) {
+		String path = "Drops." + p.getWorld().getName();
+		if (!config.getBoolean("Arena.TeleportOnKit") || !config.contains(path)) {
+			return;
+		}
+
+		List<String> dropKeys = new ArrayList<>(config.getConfigurationSection(path).getKeys(false));
+		if (dropKeys.isEmpty()) {
+			return;
+		}
+
+		p.teleport(Toolkit.getLocationFromResource(config, path + "." + dropKeys.get(random.nextInt(dropKeys.size()))));
+	}
+
 	public void updateScoreboards(Player p, boolean hide) {
